-- Функция для создания красивых переключателей (Toggle)
local function createToggle(name, posY, callback)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 200, 0, 30)
	label.Position = UDim2.new(0, 20, 0, posY)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(220, 220, 220)
	label.TextSize = 14
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = mainFrame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 60, 0, 28)
	btn.Position = UDim2.new(1, -80, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
	btn.Text = "ВЫКЛ"
	btn.TextColor3 = Color3.fromRGB(200, 200, 200)
	btn.TextSize, btn.Font = 12, Enum.Font.GothamBold
	btn.Parent = mainFrame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = btn

	local active = false
	btn.MouseButton1Click:Connect(function()
		active = not active
		if active then
			btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.Text = "ВКЛ"
		else
			btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
			btn.TextColor3 = Color3.fromRGB(200, 200, 200)
			btn.Text = "ВЫКЛ"
		end
		callback(active)
	end)
end

-- Переменные состояний
local texturesReplaced = false
local chunkCachingActive = false
local whiteModeActive = false

-- Таблицы для сохранения исходных данных объектов и кэша
local modifiedParts = {}
local visitedChunks = {}

-- ПЛАВНАЯ замена текстур/материалов порциями (по 50 объектов за кадр, чтобы не было лагов)
local function smoothReplaceTextures(enable, targetColorMode)
	task.spawn(function()
		local descendants = workspace:GetDescendants()
		local batchSize = 50 
		
		for i, obj in ipairs(descendants) do
			if obj:IsA("BasePart") then
				if enable then
					-- Сохраняем исходные свойства, если еще не сохраняли
					if not modifiedParts[obj] then
						modifiedParts[obj] = {
							Material = obj.Material,
							Color = obj.Color,
							CastShadow = obj.CastShadow
						}
					end
					
					if targetColorMode == "simplified" then
						-- 1-й режим: Упрощенные материалы (гладкий пластик), тени убираем для FPS
						obj.Material = Enum.Material.SmoothPlastic
						obj.CastShadow = false
					elseif targetColorMode == "white" then
						-- 3-й режим: Белый минимализм, но тени ОСТАВЛЯЕМ (чтобы формы не сливались)
						obj.Material = Enum.Material.SmoothPlastic
						obj.Color = Color3.fromRGB(240, 240, 240)
						obj.CastShadow = true
					end
				else
					-- Возвращаем всё как было
					local data = modifiedParts[obj]
					if data then
						obj.Material = data.Material
						obj.Color = data.Color
						obj.CastShadow = data.CastShadow
					end
				end
			elseif obj:IsA("Texture") or obj:IsA("Decal") then
				obj.Transparency = enable and 1 or 0
			end
			
			-- Пауза каждые batchSize элементов для защиты от зависаний (фризов)
			if i % batchSize == 0 then
				task.wait()
			end
		end
		print("✨ Плавная обработка мира завершена. Статус:", enable)
	end)
end

-- 1. Кнопка: Оптимизация без сохранения чанков (упрощенные текстуры)
createToggle("1. Оптимизация текстур", 60, function(state)
	texturesReplaced = state
	if state then
		if whiteModeActive then whiteModeActive = false end
		smoothReplaceTextures(true, "simplified")
	else
		smoothReplaceTextures(false, "simplified")
	end
end)

-- 2. Кнопка: Оптимизация через кэширование чанков
createToggle("2. Кэш чанков", 110, function(state)
	chunkCachingActive = state
	print("📦 Кэширование чанков:", state)
	
	local character = player.Character or player.CharacterAdded:Wait()
	
	if state then
		local chunksFolder = workspace:FindFirstChild("ChunksFolder") or workspace
		for _, chunk in ipairs(chunksFolder:GetChildren()) do
			if chunk:IsA("Model") or chunk:IsA("Folder") then
				local trigger = chunk:FindFirstChildWhichIsA("BasePart")
				if trigger then
					trigger.Touched:Connect(function(hit)
						if hit.Parent == character then
							local id = chunk.Name
							if not visitedChunks[id] then
								visitedChunks[id] = true
								print("💾 Первый проход — чанк запечен в кэш:", id)
							else
								print("⚡ Повторный проход — чанк подгружен мгновенно из кэша:", id)
							end
						end
					end)
				end
			end
		end
	end
end)

-- 3. Кнопка: Белый режим с сохранением различимости объектов (через тени)
createToggle("3. Белый режим", 160, function(state)
	whiteModeActive = state
	if state then
		if texturesReplaced then texturesReplaced = false end
		smoothReplaceTextures(true, "white")
	else
		smoothReplaceTextures(false, "white")
	end
end)
